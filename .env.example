# =================================================================
# AI Early-Risk & Referral Navigator Environment Configuration
# =================================================================

# Supabase Project Credentials
# Obtain from your Supabase Dashboard: Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase JWT Secret (Project Settings -> API -> JWT Settings)
# Used for local offline token signature verification if needed
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# Optional direct PostgreSQL connection
DATABASE_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres

# AI Assessment Provider
# Options: 'mock' (default), 'base' (OpenAI-compatible / local LLM), 'finetuned' (Unsloth checkpoint)
AI_PROVIDER=mock

# Base / OpenAI-compatible LLM Settings (used when AI_PROVIDER=base)
MODEL_NAME=meta-llama/Meta-Llama-3-8B-Instruct
MODEL_BASE_URL=https://api.together.xyz/v1
MODEL_API_KEY=your-api-key-if-applicable

# Unsloth Fine-Tuned Local Model Path (used when AI_PROVIDER=finetuned)
UNSLOTH_MODEL_PATH=./llm/checkpoints/cardionav-unsloth-lora

# Server & Network Settings
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
